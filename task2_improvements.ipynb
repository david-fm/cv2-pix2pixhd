    "def denorm(t: torch.Tensor) -> torch.Tensor:\n",
    "    \"\"\"Map a tensor from [-1, 1] back to [0, 1] for display.\"\"\"\n",
    "    return (t.clamp(-1, 1) + 1.0) / 2.0\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(12, 6))\n",
    "for col in range(4):\n",
    "    label, real = train_set[col]\n",
    "    axes[0, col].imshow(label.squeeze(0).float().cpu().numpy(), cmap='gray', vmin=0, vmax=1)\n",
    "    axes[0, col].set_title(f\"label (input)\")\n",
    "    axes[0, col].axis(\"off\")\n",
    "    axes[1, col].imshow(denorm(real).permute(1, 2, 0).numpy())\n",
    "    axes[1, col].set_title(f\"real (target)\")\n",
    "    axes[1, col].axis(\"off\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
