      "------------------------------------------------\n",
      "  L1   : 0.1513\n",
      "  PSNR : 14.3897\n",
      "  SSIM : 0.3225\n",
      "  FID  : 261.0883\n"
     ]
    }
   ],
   "source": [
    "try:\n",
    "    from torchmetrics.image import StructuralSimilarityIndexMeasure, PeakSignalNoiseRatio\n",
    "    from torchmetrics.image.fid import FrechetInceptionDistance\n",
    "except ImportError:\n",
    "    import subprocess, sys\n",
    "    subprocess.check_call([sys.executable, '-m', 'pip', 'install', 'torchmetrics[image]', 'torch-fidelity'])\n",
    "    from torchmetrics.image import StructuralSimilarityIndexMeasure, PeakSignalNoiseRatio\n",
    "    from torchmetrics.image.fid import FrechetInceptionDistance\n",
    "\n",
    "ssim_metric = StructuralSimilarityIndexMeasure(data_range=1.0).to(DEVICE)\n",
    "psnr_metric = PeakSignalNoiseRatio(data_range=1.0).to(DEVICE)\n",
    "fid_metric = FrechetInceptionDistance(feature=2048, normalize=True).to('cpu')\n",
    "\n",
    "net.eval()\n",
    "l1_total, n = 0.0, 0\n",
    "with torch.no_grad():\n",
    "    for label, real in test_loader:\n",
    "        label = label.to(DEVICE)\n",
    "        real = real.to(DEVICE)\n",
    "        # Set no_instance=True in options to avoid using instance maps\n",
    "        # We will pass empty instance maps to satisfy the API, but they won't be used by the model\n",
    "        inst = torch.zeros(label.size(0), 1, label.size(2), label.size(3)).to(DEVICE)\n",
    "        fake = net.inference(Variable(label), Variable(inst), image=None)\n",
    "\n",
    "        fake01 = (fake.clamp(-1, 1) + 1.0) / 2.0\n",
    "        real01 = (real.clamp(-1, 1) + 1.0) / 2.0\n",
    "\n",
    "        l1_total += torch.mean(torch.abs(fake01 - real01)).item() * label.size(0)\n",
    "        n += label.size(0)\n",
    "        ssim_metric.update(fake01, real01)\n",
    "        psnr_metric.update(fake01, real01)\n",
    "        fid_metric.update(real01.to('cpu'), real=True)\n",
    "        fid_metric.update(fake01.to('cpu'), real=False)\n",
    "\n",
    "results = {\n",
    "    'L1':   l1_total / max(n, 1),\n",
    "    'PSNR': psnr_metric.compute().item(),\n",
    "    'SSIM': ssim_metric.compute().item(),\n",
    "    'FID':  fid_metric.compute().item(),\n",
    "}\n",
    "print('\\nTest-set metrics (Pix2PixHD on MoNuSeg)')\n",
    "print('-' * 48)\n",
    "for k, v in results.items():\n",
    "    print(f'  {k:<5}: {v:.4f}')"
   ]
  },
