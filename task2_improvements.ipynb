    "opt.device = DEVICE  \n",
    "opt.gpu_ids = [0] if DEVICE.type == 'cuda' else []\n",
    "opt.checkpoints_dir = 'checkpoints_pix2pixHD'\n",
    "opt.name = 'pix2pixHD_monusg'\n",
    "opt.no_instance = True  # deactivate instance maps and embeddings\n",
    "opt.verbose = False\n",
    "# This configurations wont affect our training\n",
    "opt.display_freq = 200\n",
    "opt.print_freq = 200\n",
    "opt.save_latest_freq = 5000\n",
