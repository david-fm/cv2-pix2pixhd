        "from torchvision.transforms import functional as TF\n",
        "from torchvision.transforms import InterpolationMode\n",
        "\n",
        "AUGMENTATION = {\n",
        "    \"rotation_deg\": 15.0,\n",
        "    \"zoom_in_range\": (1.0, 1.15),   # extra zoom on top of the safe canvas\n",
        "    \"translate_x_frac\": 0.05,\n",
        "    \"translate_y_frac\": 0.05,\n",
        "}\n",
        "\n",
        "# Safety margin for the pre-affine canvas.\n",
        "# 1.4 comfortably covers worst-case 15° rotation + 5 % translation.\n",
        "SAFE_CANVAS_FACTOR = 1.4\n",
        "\n",
        "\n",
        "def augment_training_pair(label: torch.Tensor, real: torch.Tensor):\n",
        "    \"\"\"Apply the same geometric transform to label and real image.\n",
        "\n",
        "    Strategy: resize to a larger \"safe\" canvas first, apply the affine\n",
        "    transform there, then center-crop back to IMG_SIZE. Any black fill\n",
        "    introduced by rotation/translation falls outside the final crop region.\n",
        "    \"\"\"\n",
        "    lab = label.float()\n",
        "    rea = real\n",
        "\n",
        "    # 1. Upsample to a larger canvas so the affine margins land outside\n",
        "    #    the final central IMG_SIZE crop.\n",
        "    canvas_size = int(round(IMG_SIZE * SAFE_CANVAS_FACTOR))\n",
        "    if lab.shape[-2] != canvas_size or lab.shape[-1] != canvas_size:\n",
        "        lab = TF.resize(lab, [canvas_size, canvas_size], interpolation=InterpolationMode.NEAREST)\n",
        "        rea = TF.resize(rea, [canvas_size, canvas_size], interpolation=InterpolationMode.BICUBIC)\n",
        "\n",
        "    if torch.rand(1).item() < 0.5:\n",
        "        angle = float(torch.empty(1).uniform_(-AUGMENTATION[\"rotation_deg\"], AUGMENTATION[\"rotation_deg\"]).item())\n",
        "        scale = float(torch.empty(1).uniform_(*AUGMENTATION[\"zoom_in_range\"]).item())\n",
        "        max_dx = max(1, int(round(AUGMENTATION[\"translate_x_frac\"] * canvas_size)))\n",
        "        max_dy = max(1, int(round(AUGMENTATION[\"translate_y_frac\"] * canvas_size)))\n",
        "        translate_x = int(torch.randint(-max_dx, max_dx + 1, (1,)).item())\n",
        "        translate_y = int(torch.randint(-max_dy, max_dy + 1, (1,)).item())\n",
        "        translations = (translate_x, translate_y)\n",
        "\n",
        "        rea_fill = [float(v) for v in rea.mean(dim=(-2, -1)).tolist()]\n",
        "\n",
        "        lab = TF.affine(\n",
        "            lab,\n",
        "            angle=angle,\n",
        "            translate=translations,\n",
        "            scale=scale,\n",
        "            shear=[0.0, 0.0],\n",
        "            interpolation=InterpolationMode.NEAREST,\n",
        "            fill=0.0,\n",
        "        ).round().long()\n",
        "\n",
        "        rea = TF.affine(\n",
        "            rea,\n",
        "            angle=angle,\n",
        "            translate=translations,\n",
        "            scale=scale,\n",
        "            shear=[0.0, 0.0],\n",
        "            interpolation=InterpolationMode.BILINEAR,\n",
        "            fill=rea_fill,\n",
        "        )\n",
        "\n",
        "    # 3. Crop the central IMG_SIZE region – fill artifacts are now outside.\n",
        "    lab = TF.center_crop(lab, [IMG_SIZE, IMG_SIZE])\n",
        "    rea = TF.center_crop(rea, [IMG_SIZE, IMG_SIZE])\n",
        "\n",
        "    return lab, rea\n",
        "\n",
        "\n",
        "# Preview example (outside the function)\n",
        "import matplotlib.pyplot as plt\n",
        "# Take a single sample from the training set (not the DataLoader) and show aug result\n",
        "label_sample, real_sample = train_set[0]\n",
        "tries = 5\n",
        "for i in range(tries):\n",
        "    label_aug, real_aug = augment_training_pair(label_sample, real_sample)\n",
        "    fig, axes = plt.subplots(1, 2, figsize=(8, 4))\n",
        "    axes[0].imshow(label_aug.squeeze(0).float().cpu().numpy(), cmap='gray', vmin=0, vmax=1)\n",
        "    axes[0].set_title('label (aug)')\n",
        "    axes[0].axis('off')\n",
        "    axes[1].imshow(denorm(real_aug).permute(1, 2, 0).cpu().numpy())\n",
        "    axes[1].set_title('real (aug)')\n",
        "    axes[1].axis('off')\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ]
