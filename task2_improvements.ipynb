    "## 2. Dataset\n",
    "\n",
    "Each PNG file in `MoNuSeg/` is a horizontally concatenated pair: the **left half** contains the real histopathology image (RGB) and the **right half** contains the binary nuclei mask. For `Pix2PixHD` we apply the same preprocessing: split, resize to 256×256 and normalize to `[-1, 1]` so the generator can use `tanh` at the output.\n",
    "\n",
    "Note: For this variant we replicate the binary mask to 3 channels to keep compatibility with architectures that expect multiple input channels; alternatively `Pix2PixHD` can be configured to receive label maps with `label_nc=2` when working without instance maps.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e759525b",
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/"
    },
    "id": "e759525b",
    "outputId": "bbe5b564-ea66-4855-b474-ef76b3c95e74"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset size: 500\n",
      "  train: 350  | val: 75  | test: 75\n",
      "  batches/epoch (train): 21\n"
     ]
    }
   ],
   "source": [
    "class MoNuSegDataset(Dataset):\n",
    "    \"\"\"Paired dataset for MoNuSeg.\n",
    "\n",
    "    Returns (label_map, real_image) tensors in [-1, 1] with shape (3, H, W).\n",
    "    The label map (binary mask) is replicated to 3 channels so the generator\n",
    "    has a fixed input-channel count, matching the standard Pix2Pix layout.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, root: Path, img_size: int = 256):\n",
    "        self.files = sorted(Path(root).glob(\"*.png\"))\n",
    "        if len(self.files) == 0:\n",
    "            raise FileNotFoundError(f\"No PNG files found in {root}\")\n",
    "        self.img_size = img_size\n",
    "\n",
    "        # Separate transforms for real images and label masks\n",
    "        self.real_transform = transforms.Compose([\n",
    "            transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.BICUBIC),\n",
    "            transforms.ToTensor(),                                    # [0, 1]\n",
    "            transforms.Normalize((0.5, 0.5, 0.5), (0.5, 0.5, 0.5)),   # [-1, 1]\n",
    "        ])\n",
    "        # For labels, we want integer class IDs (0 or 1) in a single channel\n",
    "        self.label_resize = transforms.Resize((img_size, img_size), interpolation=transforms.InterpolationMode.NEAREST)\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.files)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        img = Image.open(self.files[idx]).convert(\"RGB\") # Read as RGB first\n",
    "        w, h = img.size\n",
    "        half = w // 2\n",
    "        real_img  = img.crop((0,    0, half, h))   # left  -> realistic histology\n",
    "        label_mask = img.crop((half, 0, w,    h)) # right -> nuclei mask\n",
    "\n",
    "        # Apply transforms\n",
    "        real_tensor = self.real_transform(real_img)\n",
    "\n",
    "        # For the label mask, convert to grayscale (L) to get a single channel,\n",
    "        # resize, convert to tensor (0.0 or 1.0), and then to long (0 or 1).\n",
    "        label_pil_resized = self.label_resize(label_mask.convert(\"L\"))\n",
    "        # ToTensor will make it 0.0 or 1.0, then cast to long to get 0 or 1\n",
    "        label_tensor = (transforms.ToTensor()(label_pil_resized) > 0.5).long()\n",
    "\n",
    "        return label_tensor, real_tensor\n",
    "\n",
    "\n",
    "# Build dataset and 70/15/15 split\n",
    "full_dataset = MoNuSegDataset(DATA_DIR, img_size=IMG_SIZE)\n",
    "n_total = len(full_dataset)\n",
    "n_train = int(0.70 * n_total)\n",
    "n_val   = int(0.15 * n_total)\n",
    "n_test  = n_total - n_train - n_val\n",
    "\n",
    "indices = list(range(n_total))\n",
    "rng = np.random.default_rng(SEED)\n",
    "rng.shuffle(indices)\n",
    "train_idx = indices[:n_train]\n",
    "val_idx   = indices[n_train:n_train + n_val]\n",
    "test_idx  = indices[n_train + n_val:]\n",
    "\n",
    "train_set = Subset(full_dataset, train_idx)\n",
    "val_set   = Subset(full_dataset, val_idx)\n",
    "test_set  = Subset(full_dataset, test_idx)\n",
    "\n",
    "train_loader = DataLoader(train_set, batch_size=BATCH_SIZE, shuffle=True,\n",
    "                          num_workers=NUM_WORKERS, drop_last=True)\n",
    "val_loader   = DataLoader(val_set,   batch_size=BATCH_SIZE, shuffle=False,\n",
    "                          num_workers=NUM_WORKERS)\n",
    "test_loader  = DataLoader(test_set,  batch_size=BATCH_SIZE, shuffle=False,\n",
    "                          num_workers=NUM_WORKERS)\n",
    "\n",
    "print(f\"Dataset size: {n_total}\")\n",
    "print(f\"  train: {len(train_set)}  | val: {len(val_set)}  | test: {len(test_set)}\")\n",
    "print(f\"  batches/epoch (train): {len(train_loader)}\")"
   ]
  },
  {
