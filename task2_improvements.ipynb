        "import time\n",
        "\n",
        "# ---------- Early-stopping configuration ----------\n",
        "PATIENCE = 30          # epochs without improvement before stopping\n",
        "MIN_DELTA = 1e-4       # minimum change to count as improvement\n",
        "\n",
        "history = {\"g_loss\": [], \"d_loss\": [], \"val_g_loss\": [], \"val_d_loss\": []}\n",
        "best_val_g = float('inf')\n",
        "patience_counter = 0\n",
        "best_epoch = 0\n",
        "\n",
        "\n",
        "def validate(model, val_loader, device):\n",
        "    \"\"\"Run one validation pass and return average (G_loss, D_loss).\"\"\"\n",
        "    net_eval = model.module if hasattr(model, 'module') else model\n",
        "    net_eval.eval()\n",
        "    val_g, val_d = 0.0, 0.0\n",
        "    with torch.no_grad():\n",
        "        for label, real in val_loader:\n",
        "            label = label.to(device)\n",
        "            real = real.to(device)\n",
        "\n",
        "            losses, _ = model(Variable(label), None, Variable(real), None, infer=False)\n",
        "\n",
        "            losses = [torch.mean(x) if not isinstance(x, int) else x for x in losses]\n",
        "            loss_names = getattr(net_eval, 'loss_names', None)\n",
        "            if loss_names is None:\n",
        "                loss_names = ['G_GAN', 'G_GAN_Feat', 'G_VGG', 'D_real', 'D_fake']\n",
        "            loss_dict = dict(zip(loss_names[:len(losses)], losses))\n",
        "\n",
        "            loss_D = sum(v for k, v in loss_dict.items() if k.startswith('D_'))\n",
        "            loss_G = sum(v for k, v in loss_dict.items() if k.startswith('G_'))\n",
        "\n",
        "            val_g += loss_G.item() if isinstance(loss_G, torch.Tensor) else float(loss_G)\n",
        "            val_d += loss_D.item() if isinstance(loss_D, torch.Tensor) else float(loss_D)\n",
        "\n",
        "    n_batches = len(val_loader)\n",
        "    return val_g / n_batches, val_d / n_batches\n",
        "\n",
        "\n",
        "total_steps = 0\n",
        "start_time = time.time()\n",
        "for epoch in range(1, opt.niter + opt.niter_decay + 1):\n",
        "    epoch_g, epoch_d = 0.0, 0.0\n",
        "    net.train()\n",
        "    for i, (label, real) in enumerate(train_loader):\n",
        "        label = label.to(DEVICE)\n",
        "        real = real.to(DEVICE)\n",
        "\n",
        "        label, real = augment_training_pair(label, real)\n",
        "\n",
        "        # forward & compute losses via the API of the modelo\n",
        "        save_fake = False\n",
        "        losses, generated = model(Variable(label), None, Variable(real), None, infer=save_fake)\n",
        "\n",
        "        # mean over devices/tensors\n",
        "        losses = [torch.mean(x) if not isinstance(x, int) else x for x in losses]\n",
        "        loss_names = getattr(net, 'loss_names', None)\n",
        "        if loss_names is None:\n",
        "            # fallback: wait for standard loss names, indicated in the pix2pixHD code\n",
        "            loss_names = ['G_GAN', 'G_GAN_Feat', 'G_VGG', 'D_real', 'D_fake']\n",
        "        loss_dict = dict(zip(loss_names[:len(losses)], losses))\n",
        "\n",
        "        # Make combined losses for G and D based on prefixes\n",
        "        loss_D = sum(v for k, v in loss_dict.items() if k.startswith('D_'))\n",
        "        loss_G = sum(v for k, v in loss_dict.items() if k.startswith('G_'))\n",
        "\n",
        "        # update generator\n",
        "        optimizer_G.zero_grad()\n",
        "        loss_G.backward()\n",
        "        optimizer_G.step()\n",
        "\n",
        "        # update discriminator\n",
        "        optimizer_D.zero_grad()\n",
        "        loss_D.backward()\n",
        "        optimizer_D.step()\n",
        "\n",
        "        epoch_g += loss_G.item() if isinstance(loss_G, torch.Tensor) else float(loss_G)\n",
        "        epoch_d += loss_D.item() if isinstance(loss_D, torch.Tensor) else float(loss_D)\n",
        "        total_steps += 1\n",
        "\n",
        "    n_batches = len(train_loader)\n",
        "    history[\"g_loss\"].append(epoch_g / n_batches)\n",
        "    history[\"d_loss\"].append(epoch_d / n_batches)\n",
        "\n",
        "    # ---- Validation ----\n",
        "    val_g, val_d = validate(model, val_loader, DEVICE)\n",
        "    history[\"val_g_loss\"].append(val_g)\n",
        "    history[\"val_d_loss\"].append(val_d)\n",
        "\n",
        "    elapsed = time.time() - start_time\n",
        "    print(f'Epoch {epoch:03d}/{opt.niter + opt.niter_decay} | '\n",
        "          f'G {history[\"g_loss\"][-1]:.4f} | D {history[\"d_loss\"][-1]:.4f} | '\n",
        "          f'Val G {val_g:.4f} | Val D {val_d:.4f} | {elapsed/60:.1f} min')\n",
        "\n",
        "    if epoch % opt.save_epoch_freq == 0:\n",
        "        net.save('latest')\n",
        "        net.save(epoch)\n",
        "\n",
        "    # ---- Early stopping (monitor validation generator loss) ----\n",
        "    if val_g < best_val_g - MIN_DELTA:\n",
        "        best_val_g = val_g\n",
        "        patience_counter = 0\n",
        "        best_epoch = epoch\n",
        "        net.save('best')\n",
        "        print(f'  -> New best val G loss: {best_val_g:.4f} (saved best model)')\n",
        "    else:\n",
        "        patience_counter += 1\n",
        "        if patience_counter >= PATIENCE:\n",
        "            print(f'\\nEarly stopping triggered! No improvement in val G loss for {PATIENCE} epochs.')\n",
        "            print(f'Best epoch: {best_epoch} with val G loss {best_val_g:.4f}')\n",
        "            break\n",
        "\n",
        "print('Training complete.')"
      ]
    },
