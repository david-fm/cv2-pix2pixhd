    "import time\n",
    "\n",
    "history = {\"g_loss\": [], \"d_loss\": []}\n",
    "\n",
    "total_steps = 0\n",
    "start_time = time.time()\n",
    "for epoch in range(1, opt.niter + opt.niter_decay + 1):\n",
    "    epoch_g, epoch_d = 0.0, 0.0\n",
    "    net.train()\n",
    "    for i, (label, real) in enumerate(train_loader):\n",
    "        label = label.to(DEVICE)\n",
    "        real = real.to(DEVICE)\n",
    "\n",
    "        label, real = augment_training_pair(label, real)\n",
    "\n",
    "        # forward & compute losses via the API of the modelo\n",
    "        save_fake = False\n",
    "        losses, generated = model(Variable(label), None, Variable(real), None, infer=save_fake)\n",
    "\n",
    "        # mean over devices/tensors\n",
    "        losses = [ torch.mean(x) if not isinstance(x, int) else x for x in losses ]\n",
    "        loss_names = getattr(net, 'loss_names', None)\n",
    "        if loss_names is None:\n",
    "            # fallback: wait for standard loss names, indicated in the pix2pixHD code\n",
    "            loss_names = ['G_GAN', 'G_GAN_Feat', 'G_VGG', 'D_real', 'D_fake']\n",
    "        loss_dict = dict(zip(loss_names[:len(losses)], losses))\n",
    "\n",
    "        # Make combined losses for G and D based on prefixes\n",
    "        loss_D = sum(v for k, v in loss_dict.items() if k.startswith('D_'))\n",
    "        loss_G = sum(v for k, v in loss_dict.items() if k.startswith('G_'))\n",
    "\n",
    "        # update generator\n",
    "        optimizer_G.zero_grad()\n",
    "        loss_G.backward()\n",
    "        optimizer_G.step()\n",
    "\n",
    "        # update discriminator\n",
    "        optimizer_D.zero_grad()\n",
    "        loss_D.backward()\n",
    "        optimizer_D.step()\n",
    "\n",
    "        epoch_g += loss_G.item() if isinstance(loss_G, torch.Tensor) else float(loss_G)\n",
    "        epoch_d += loss_D.item() if isinstance(loss_D, torch.Tensor) else float(loss_D)\n",
    "        total_steps += 1\n",
    "\n",
    "    n_batches = len(train_loader)\n",
    "    history[\"g_loss\"].append(epoch_g / n_batches)\n",
    "    history[\"d_loss\"].append(epoch_d / n_batches)\n",
    "\n",
    "    elapsed = time.time() - start_time\n",
    "    print(f'Epoch {epoch:03d}/{opt.niter + opt.niter_decay} | G {history[\"g_loss\"][-1]:.4f} | D {history[\"d_loss\"][-1]:.4f} | {elapsed/60:.1f} min')\n",
    "\n",
    "    if epoch % opt.save_epoch_freq == 0:\n",
    "        net.save('latest')\n",
    "        net.save(epoch)\n",
    "\n",
    "print('Training complete.')"
   ]
  },
