    "opt.lr = LR\n",
    "opt.batchSize = BATCH_SIZE\n",
    "opt.no_vgg_loss = False  # use VGG loss\n",
    "opt.no_ganFeat_loss = False  # use GAN feature matching loss\n",
    "# Adjust options to match MoNuSegDataset output\n",
    "opt.label_nc = 2      # Input label has 2 classes (background and nuclei)\n",
    "opt.fineSize = IMG_SIZE # Use actual image size from dataset\n",
    "opt.loadSize = IMG_SIZE # Use actual image size from dataset\n",
    "\n",
    "opt = opt.parse(save=False)\n",
    "\n",
    "if opt.no_instance:\n",
